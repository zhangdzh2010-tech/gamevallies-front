map $http_upgrade $connection_upgrade { default upgrade; '' close; }
resolver ${FC_DNS_RESOLVER} valid=30s ipv6=off;
server {
    listen 8080;
    server_name _;
    root /code/html;
    index index.html;
    set $api ${API_UPSTREAM};
    client_max_body_size 6m;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /code/ca-certificates.crt;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-GameVallies-Internal-Token ${GAMEVALLIES_FC_INTERNAL_TOKEN};
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_buffering off;
    location ^~ /__fc/ { return 404; }
    location ^~ /api/v1/internal/ { return 404; }
    location ^~ /api/v1/ai/ { return 404; }
    location ^~ /ai/ { return 404; }
    # FC default *.aliyuncs.com triggers force Content-Disposition: attachment.
    # Custom domains do not, so hide the header after proxying HTML/API pages.
    # Keep growth downloads untouched so APK/IPA still attach a filename.
    location ^~ /api/v1/growth { proxy_pass $api$request_uri; }
    location ^~ /api/ {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
    }
    location ^~ /users/ {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
    }
    location ^~ /admin/assets/ {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
        proxy_buffering on;
        proxy_cache admin_assets;
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
        proxy_cache_lock on;
    }
    location ^~ /admin {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
    }
    location ^~ /games/ {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
    }
    location ^~ /game-shell/ {
        proxy_pass $api$request_uri;
        proxy_hide_header Content-Disposition;
    }
    location ^~ /socket.io/ {
        proxy_pass $api$request_uri;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-GameVallies-Internal-Token ${GAMEVALLIES_FC_INTERNAL_TOKEN};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location ^~ /ws/socket.io/ {
        rewrite ^/ws/(.*)$ /$1 break;
        proxy_pass $api$uri$is_args$args;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-GameVallies-Internal-Token ${GAMEVALLIES_FC_INTERNAL_TOKEN};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
    location = /9002299597e76e062cb56930926ed40c.txt { proxy_pass $api$request_uri; }
    location /ws { return 404; }


    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # gzip 压缩
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # index.html 永不缓存，确保每次部署后浏览器拉取最新入口
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    # SPA 路由: 所有非文件请求返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # 带内容哈希的静态资源（chunk/*.js 等）可长期缓存
    location /chunk/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # app.js / css/app.css 文件名不含哈希，不能强缓存
    location ~* \.(js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        etag on;
    }

    # 图片字体等带哈希的资源可长期缓存
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
    }
}

