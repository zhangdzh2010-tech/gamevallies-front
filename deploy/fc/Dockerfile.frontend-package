FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG PUBLIC_ORIGIN=https://www.zlspace.ai
ARG CONTENT_ORIGIN
RUN test -n "$CONTENT_ORIGIN" && TARO_APP_AUTH_SERVICE_URL="$PUBLIC_ORIGIN" TARO_APP_GAME_SERVICE_URL="$PUBLIC_ORIGIN" TARO_APP_SOCIAL_SERVICE_URL="$PUBLIC_ORIGIN" TARO_APP_FEED_SERVICE_URL="$PUBLIC_ORIGIN" TARO_APP_AI_SERVICE_URL="$PUBLIC_ORIGIN" TARO_APP_WS_URL="$PUBLIC_ORIGIN" TARO_APP_GAME_CONTENT_URL="$CONTENT_ORIGIN" TARO_APP_GAME_SHELL_URL="$CONTENT_ORIGIN" npm run build:h5
FROM debian:bookworm-slim AS package
RUN apt-get update && apt-get install -y --no-install-recommends nginx gettext-base python3 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /code && cp /usr/sbin/nginx /usr/bin/envsubst /etc/nginx/mime.types /code/
COPY --from=build /app/dist/h5 /code/html
COPY 33zqDBay4T.txt /code/html/33zqDBay4T.txt
COPY deploy/fc/frontend.conf.template /code/frontend.template
COPY deploy/fc/frontend-entrypoint.sh /code/frontend-entrypoint.sh
COPY deploy/fc/bootstrap-nginx /code/bootstrap
RUN chmod 755 /code/bootstrap
COPY scripts/fc/pack.py /pack.py
RUN python3 /pack.py frontend
FROM scratch
COPY --from=package /out/ /
